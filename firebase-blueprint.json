{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Solar product or component in inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "productName": { "type": "string" },
        "make": { "type": "string" },
        "category": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "stock": { "type": "number" },
        "unit": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Solar customer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "city": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Project": {
      "title": "Project",
      "description": "Solar installation project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "customerName": { "type": "string" },
        "systemCapacity": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "projectId"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "GST Tax invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "grandTotal": { "type": "number" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["id", "invoiceNumber"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Solar system quotation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quoteNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "grandTotal": { "type": "number" }
      },
      "required": ["id", "quoteNumber"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment receipt transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNo": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "receiptNo"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Company operational expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Company staff member",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "designation": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "StockLog": {
      "title": "StockLog",
      "description": "Inventory stock movement log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["id", "itemName"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Global company profile and configuration",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "gstNumber": { "type": "string" }
      },
      "required": ["companyName"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product master catalog"
    },
    "/inventory/{itemId}": {
      "schema": "Product",
      "description": "Inventory items"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer records"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Solar installation projects"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "GST Tax Invoices"
    },
    "/quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Solar Quotations"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment records"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Company expenses"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Employees"
    },
    "/stockLogs/{logId}": {
      "schema": "StockLog",
      "description": "Stock logs"
    },
    "/settings/{settingId}": {
      "schema": "CompanySettings",
      "description": "Company Settings"
    }
  }
}
